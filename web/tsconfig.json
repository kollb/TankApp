{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/api/**/*.ts",
    "src/state/AppContext.tsx",
    "src/state/useOverview.ts",
    "src/components/layout/**/*.tsx",
    "src/components/ui/**/*.tsx",
    "src/utils/**/*.ts",
    "src/readToken.ts",
    "vite.config.ts",
    "rp2",
    "vite.rp2.config.ts"
  ]
}
