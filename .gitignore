# Rohdaten, Exporte und Modell-Artefakte bleiben lokal
data/
# Kennzahlen, Berichte und Abbildungen werden pro Lauf neu erzeugt
results/
__pycache__/
*.pyc

# lokale venvs (nicht versioniert)
.venv/
.venv-ci/
.venv-m3/

# Privatdaten (Heimkoordinaten, API-Keys) — niemals versionieren
config.local.json
analysis/config.local.json

# polling.json enthält die privaten Anker-Koordinaten aus config.local.json
polling.json

# netrc-Zugangsdateien — auch wenn sie (Windows: _netrc) im Repo-Ordner liegen
.netrc
_netrc
*.netrc

# Tankerkoenig-API-Key-Datei fuer den Collector (data-tools/collect_prices.py)
data/apikey.txt

# InfluxDB-Config auf dem NAS (Admin-Token) — nie versionieren
ops/nas/influxdb/.env

# Lokale Selektionsberichte und Stations-Metadaten (inkl. privatem Polling-Set)
# Neuer Ort ist data/analysis/ (bereits über data/ ignoriert); der alte Pfad
# bleibt ignoriert, solange Installationen ihn noch verwenden (B14).
/docs/analysis/
/data/analysis/
# Test-/Lint-Ausgaben
.pytest_cache/
.ruff_cache/
# Coverage-Artefakte aus dem lokalen Aufruf in docs/TESTABDECKUNG.md
.coverage
coverage.xml
pytest.xml
pytest-coverage.txt
# Lokale Secrets, auch außerhalb des bisherigen NAS-Pfads
.env
apikey.txt

# RP2-Fallback-GUI schreibt ihre HTML-Vorlage beim Start selbst
rp2/templates/

# GUI-Vorlagen bleiben im Repo, lokale JS-Artefakte/Secrets nicht
node_modules/
.next/
.env.local
.env.*.local
*.tsbuildinfo

# Compiled application assets are built by the NAS image / local web build
/web/dist/
/web/test-results/
/web/playwright-report/

# Lokale E2E-Konfigurationen (Sandbox/SwiftShader-Rendering) — CI nutzt
# playwright.config.ts / playwright.demo.config.ts.
/web/playwright.local.config.ts
/web/playwright.demo.local.config.ts

# Private NAS read access, also when placed outside data/
influx.env
netrc

# Qualitäts-Gates (D4): Lighthouse-Artefakte und Lastbericht
/.lighthouseci/
/web/.lighthouseci/
/load-report.json

# E2E ohne Mocks (web/e2e/demo.spec.ts): Demo-Datenbestand des Demo-Stacks
/.demo-e2e-data/
/.demo-preview-data/

# Lokale virtuelle Umgebung
.venv/
