[Unit]
Description=TankApp RP2 Forecast Cache - Lädt Prognosen vom NAS
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/TankApp/rp2
ExecStart=/usr/bin/python3 /home/pi/TankApp/rp2/cache_forecasts.py
Restart=always
RestartSec=60

# NAS-IP NICHT hier eintragen, sondern in einem Drop-in, damit ein
# "git pull" die Konfiguration nicht ueberschreibt:
#   sudo systemctl edit tankapp-forecast-cache
# und dort eintragen:
#   [Service]
#   Environment=NAS_IP=192.168.178.50
Environment=NAS_PORT=1355
Environment=CACHE_INTERVAL_SECONDS=300

[Install]
WantedBy=multi-user.target
