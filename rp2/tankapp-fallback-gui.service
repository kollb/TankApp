[Unit]
Description=TankApp RP2 Fallback GUI - Zeigt Live-Preise + gecachte Prognosen
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/TankApp/rp2
ExecStart=/usr/bin/python3 /home/pi/TankApp/rp2/fallback_gui.py
Restart=always
RestartSec=5

# NAS-IP NICHT hier eintragen, sondern in einem Drop-in:
#   sudo systemctl edit tankapp-fallback-gui
#   [Service]
#   Environment=NAS_IP=192.168.178.50
Environment=NAS_PORT=1355
Environment=FALLBACK_GUI_PORT=8000

[Install]
WantedBy=multi-user.target
