# TankApp – InfluxDB auf dem NAS (einmaliges Setup, INSTALL.md Phase C §3.1).
#
# So nutzen:  cp .env.example .env && nano .env
# (Die .env ist gitignored — Secret, nie im Repo.)

# Admin-Token (Web-UI + Erst-Setup). Einmalig erzeugen und eintragen:
#   openssl rand -hex 16
INFLUXDB_ADMIN_TOKEN=change-me-openssl-rand-hex-16

# Passwort des Admin-Users (nur für die Web-UI; der Pi-Uploader nutzt
# ein eigenes Least-Privilege-Token, siehe §3.1).
INFLUXDB_ADMIN_PASSWORD=change-me-too

# Org & Bucket — werden beim ersten Container-Start automatisch mit
# 43800h ≈ 5 Jahre Retention angelegt (docker-compose.yml):
INFLUXDB_ORG=tankapp
INFLUXDB_BUCKET=prices
