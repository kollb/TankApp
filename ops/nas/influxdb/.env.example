# TankApp – InfluxDB auf dem NAS (einmaliges Setup, INSTALL.md Phase C §3.1).
#
# WICHTIG: Läuft auf dem NAS bereits eine InfluxDB-Instanz (bei uns:
# 192.168.178.61, Org `gtwrlab` mit dem `smarthome`-Bucket), NICHTS hier
# starten (Port 8086 belegt) — in der bestehenden Instanz nur Bucket +
# Token anlegen:
#   influx bucket create --org gtwrlab --name tankapp --retention 43800h
#   influx auth create --org gtwrlab --read-bucket tankapp \
#       --write-bucket tankapp --description "tankapp-uploader (Pi)"
#
# Diese .env gilt NUR für eine frisch aufgesetzte Instanz (docker-compose.yml).
# So nutzen:  cp .env.example .env && nano .env
# (Die .env ist gitignored — Secret, nie im Repo.)

# Admin-Token (Web-UI + Erst-Setup). Einmalig erzeugen und eintragen:
#   openssl rand -hex 16
INFLUXDB_ADMIN_TOKEN=change-me-openssl-rand-hex-16

# Passwort des Admin-Users (nur für die Web-UI; der Pi-Uploader nutzt
# ein eigenes Least-Privilege-Token, siehe INSTALL.md §3.1).
INFLUXDB_ADMIN_PASSWORD=change-me-too

# Org & Bucket — werden beim ersten Container-Start automatisch mit
# 43800h ≈ 5 Jahre Retention angelegt (docker-compose.yml).
# Gleiche Namen wie die bestehende Instanz, damit die /etc/tankapp/env
# auf dem Pi identisch bleibt:
INFLUXDB_ORG=gtwrlab
INFLUXDB_BUCKET=tankapp
